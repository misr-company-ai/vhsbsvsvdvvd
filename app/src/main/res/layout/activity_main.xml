<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/blue_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:background="@color/white"
            android:text="خدمة النقر: غير مفعّلة"
            android:textColor="@color/red_stop"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEnableService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/blue_mid"
            android:text="تفعيل خدمة إمكانية الوصول" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/blue_mid"
            android:text="السماح بالظهور فوق التطبيقات" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="طريقة النقر"
            android:textColor="@color/blue_dark"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="نقر على نقطة محددة في الشاشة" />

            <RadioButton
                android:id="@+id/radioText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نقر على نص/كلمة معينة تظهر في الشاشة" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPickPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/blue_light"
            android:text="تحديد نقطة النقر على الشاشة" />

        <TextView
            android:id="@+id/tvPointValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="لم يتم تحديد نقطة بعد"
            android:textColor="@android:color/darker_gray" />

        <EditText
            android:id="@+id/etTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/white"
            android:padding="12dp"
            android:hint="اكتب الكلمة أو النص المطلوب الضغط عليه" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="الفاصل الزمني بين كل نقرة (بالمللي ثانية)"
            android:textColor="@color/blue_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            android:padding="12dp"
            android:inputType="number"
            android:text="1000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="مدة التشغيل الكلية (بالثواني، 0 = بلا حدود)"
            android:textColor="@color/blue_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            android:padding="12dp"
            android:inputType="number"
            android:text="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تأخير قبل بدء النقر (بالثواني)"
            android:textColor="@color/blue_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etStartDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            android:padding="12dp"
            android:inputType="number"
            android:text="3" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/blue_dark"
            android:text="ابدأ النقر التلقائي"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/red_stop"
            android:text="إيقاف" />

    </LinearLayout>
</ScrollView>
